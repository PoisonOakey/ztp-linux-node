# Copy this file to .env and set a real value before deploying manually.
# The Ansible monitoring role does not use this file: it renders .env onto the
# node from templates/env.j2, with a password generated once on the control node
# and reused afterwards. This template is for a manual `docker compose up` and
# for CI, which needs a .env present to validate the Compose file.
GF_SECURITY_ADMIN_PASSWORD=changeme
