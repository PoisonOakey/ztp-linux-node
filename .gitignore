# PowerShell Transcript Logs
/logs/*
!/logs/.gitkeep

# VirtualBox Artifacts
*.vdi
*.iso
cidata_mount/
cidata.vhd

# Secrets (see monitoring/.env.example for the template)
monitoring/.env

# Internal working notes -- not project documentation
docs/WORK-ORDER.md

# Ansible run artifacts
*.retry
ansible/*.log

# Generated Grafana admin password -- lives on the control node only
ansible/.grafana_admin_password
