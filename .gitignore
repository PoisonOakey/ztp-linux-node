# PowerShell Transcript Logs
/logs/*
!/logs/.gitkeep

# VirtualBox Artifacts
*.vdi
*.iso
cidata_mount/
cidata.vhd

# Secrets (see monitoring/.env.example for the template)
monitoring/.env

# Internal working notes -- not project documentation
docs/WORK-ORDER.md

# Ansible run artifacts
*.retry
ansible/*.log

# Scratch output from the CI config-validate job, if it is run locally
.ci-render.yml
.ci-rendered/

# Credentials that live on the control node only, never in the repository
ansible/.grafana_admin_password
ansible/.tailscale_auth_key
ansible/.discord_webhook_url
